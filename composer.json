{
    "name": "zemailme/zemail-php",
    "description": "The official PHP SDK for Zemail Developer API.",
    "type": "library",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "ext-json": "*"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.2",
        "laravel/pint": "^1.30"
    },
    "keywords": [
        "zemail",
        "temp-mail",
        "temporary-email",
        "disposable-email",
        "email-api",
        "php-sdk"
    ],
    "homepage": "https://zemail.me",
    "support": {
        "issues": "https://github.com/zemailme/zemail-php/issues",
        "source": "https://github.com/zemailme/zemail-php",
        "docs": "https://zemail.me/api-docs"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Zemail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zemail\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Zemail Support",
            "email": "support@zemail.me"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:types": "phpstan analyse",
        "format": "pint",
        "release": "npx release-it",
        "release:dry": "npx release-it --dry-run"
    }
}
